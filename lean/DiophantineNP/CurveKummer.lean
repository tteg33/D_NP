import DiophantineNP.CurveSaturation
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.RingTheory.AdjoinRoot

/-! # The cubic descent map for 37a1

The change of coordinates X=4x, Y=8y+4 identifies the curve with Y²=X³−16X+16.
Its cubic algebra is the field generated by θ³−4θ+2=0. -/
namespace DiophantineNP.Curve37.Kummer

open WeierstrassCurve Polynomial
noncomputable section

def f : ℚ[X] := X^3 - 4*X + 2

theorem degree_f : f.natDegree = 3 := by
  unfold f
  compute_degree!

theorem monic_f : f.Monic := by
  unfold f
  monicity <;> decide

theorem irreducible_f : Irreducible f := by
  rw [monic_f.irreducible_iff_roots_eq_zero_of_degree_le_three (by rw [degree_f]; decide)
    (by rw [degree_f])]
  apply Multiset.eq_zero_of_forall_notMem
  intro r hr
  have hz := (mem_roots monic_f.ne_zero).mp hr
  simp [IsRoot,f] at hz
  apply cubic_ne_zero (r/2)
  linarith only [hz]

instance : Fact (Irreducible f) := ⟨irreducible_f⟩
abbrev L := AdjoinRoot f
def θ : L := AdjoinRoot.root f

@[simp] theorem theta_cube : θ^3=4*θ-2 := by
  have h := AdjoinRoot.mk_self (f:=f)
  conv_lhs at h => arg 2; unfold f
  simp only [map_add,map_sub,map_mul,map_pow,map_ofNat,AdjoinRoot.mk_X] at h
  change θ^3-4*θ+2=0 at h
  linear_combination h

instance : CharZero L := charZero_of_injective_algebraMap (algebraMap ℚ L).injective

/-- Coordinates in the rational basis 1,θ,θ². -/
def triple (a b c : ℚ) : L := (a:L)+(b:L)*θ+(c:L)*θ^2

def basis : Module.Basis (Fin 3) ℚ L :=
  (AdjoinRoot.powerBasis monic_f.ne_zero).basis.reindex (finCongr degree_f)

theorem basis_apply (i : Fin 3) : basis i=θ^i.val := by
  rw [basis,Module.Basis.reindex_apply,PowerBasis.basis_eq_pow]
  rfl

lemma repr_triple (a b c : ℚ) : triple a b c =
    ∑ i : Fin 3, ![a,b,c] i • basis i := by
  rw [Fin.sum_univ_three]
  simp [basis_apply,triple,Algebra.smul_def]

theorem triple_inj {a b c d e g : ℚ} (h : triple a b c=triple d e g) :
    a=d ∧ b=e ∧ c=g := by
  rw [repr_triple,repr_triple] at h
  have h' (i : Fin 3) := congrArg (fun t => basis.repr t i) h
  simp only [map_sum,map_smul,Module.Basis.repr_self,Finset.sum_apply',Finsupp.smul_apply,
    Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true] at h'
  exact ⟨h' 0,h' 1,h' 2⟩

theorem exists_triple (r : L) : ∃ a b c : ℚ, r = triple a b c := by
  refine ⟨basis.repr r 0,basis.repr r 1,basis.repr r 2,?_⟩
  rw [repr_triple]
  apply (basis.sum_repr r).symm.trans
  apply Finset.sum_congr rfl
  intro i _
  fin_cases i <;> rfl

private theorem triple_sq (a b c : ℚ) :
    (triple a b c)^2=triple (a^2-4*b*c) (2*a*b+8*b*c-2*c^2) (b^2+2*a*c+4*c^2) := by
  dsimp only [triple]
  push_cast
  linear_combination (2*(b:L)*(c:L)+(c:L)^2*θ) * theta_cube

private def s1 (a _b c : ℚ) := 3*a+8*c
private def s2 (a b c : ℚ) := 3*a^2+16*a*c-4*b^2+6*b*c+16*c^2
private def s3 (a b c : ℚ) :=
  a^3+8*a^2*c-4*a*b^2+6*a*b*c+16*a*c^2-2*b^3+8*b*c^2+4*c^3

/-- The elementary symmetric functions of a square root give the slope and the
shift in x of a half. The sign of the square root is chosen by the ordinate. -/
private theorem halving_parameters (X Y : ℚ) (hY : Y^2=X^3-16*X+16)
    (h : IsSquare (triple X (-2) 0)) :
    ∃ s t : ℚ, s^2=3*X+2*t ∧ t^2+2*s*Y=3*X^2-16 := by
  obtain ⟨v,hv⟩ := h
  obtain ⟨a,b,c,rfl⟩ := exists_triple v
  rw [←sq,triple_sq] at hv
  obtain ⟨e₀,e₁,e₂⟩ := triple_inj hv.symm
  have h₁ : (s1 a b c)^2-2*s2 a b c = 3*X := by
    rw [←e₀]
    dsimp [s1,s2]
    linear_combination 8 * e₂
  have h₂ : (s2 a b c)^2-2*s1 a b c*s3 a b c=3*X^2-16 := by
    have H : (s2 a b c)^2-2*s1 a b c*s3 a b c =
      s2 (a^2-4*b*c) (2*a*b+8*b*c-2*c^2) (b^2+2*a*c+4*c^2) := by dsimp [s1,s2,s3]; ring
    rw [H,e₀,e₁,e₂]
    dsimp [s2]; ring
  have h₃ : (s3 a b c)^2=Y^2 := by
    have H : (s3 a b c)^2=s3 (a^2-4*b*c) (2*a*b+8*b*c-2*c^2) (b^2+2*a*c+4*c^2) := by dsimp [s3]; ring
    rw [H,e₀,e₁,e₂,hY]
    dsimp [s3]; ring
  rcases eq_or_eq_neg_of_sq_eq_sq _ _ h₃ with he|he
  · exact ⟨-(s1 a b c),s2 a b c,by linarith only [h₁],by rw [he] at h₂; linarith only [h₂]⟩
  · exact ⟨s1 a b c,s2 a b c,by linarith only [h₁],by rw [he] at h₂; linarith only [h₂]⟩

theorem curve_eq {x y : ℚ} (h : E.Nonsingular x y) : y^2+y=x^3-x := by
  have he := (Affine.equation_iff x y).mp ((Affine.nonsingular_iff x y).mp h).1
  dsimp [E] at he
  linarith only [he]

private theorem nonsingular_of_curve_eq {x y : ℚ} (he : y^2+y=x^3-x) : E.Nonsingular x y := by
  apply (Affine.equation_iff_nonsingular_of_Δ_ne_zero (W:=E) (by rw [discriminant]; norm_num)).mp
  rw [Affine.equation_iff]
  dsimp [E]; linarith only [he]

private theorem ordinate_ne {X Y : ℚ} (h : Y^2=X^3-16*X+16) : Y≠0 := by
  rintro rfl
  apply cubic_ne_zero (X/4)
  linarith only [h]

private theorem double_of_tangent {x y U V m : ℚ} (h : E.Nonsingular x y)
    (hV : V^2=U^3-16*U+16) (htan : 2*V*m=3*U^2-16) (hm : m^2=2*U+4*x)
    (hv : m*(U-4*x)-V=8*y+4) : ∃ R : E.Point, R+R=Affine.Point.some h := by
  have hR : E.Nonsingular (U/4) ((V-4)/8) := by
    apply nonsingular_of_curve_eq
    linarith only [hV]
  have hVne := ordinate_ne hV
  have hny : (V-4)/8 ≠ E.negY (U/4) ((V-4)/8) := by
    dsimp [E,Affine.negY]
    intro he
    exact hVne (by linarith only [he])
  have hs : E.slope (U/4) (U/4) ((V-4)/8) ((V-4)/8)=m/2 := by
    rw [Affine.slope_of_Y_ne rfl hny]
    apply (div_eq_iff (sub_ne_zero.mpr hny)).2
    dsimp [E,Affine.negY]
    linarith only [htan]
  refine ⟨Affine.Point.some hR,?_⟩
  rw [Affine.Point.add_self_of_Y_ne hny,Affine.Point.some.injEq,hs]
  have hx' : E.addX (U/4) (U/4) (m/2)=x := by dsimp [Affine.addX,E]; linarith only [hm]
  refine ⟨hx',?_⟩
  rw [Affine.addY,Affine.negAddY,hx']
  dsimp [Affine.negY,E]
  linarith only [hv]

/-- The usual Kummer representative, with the identity represented by one. -/
def image : E.Point → L
  | .zero => 1
  | .some (x:=x) _ => triple (4*x) (-2) 0

theorem double_of_square (Q : E.Point) (h : IsSquare (image Q)) :
    ∃ R : E.Point, R+R=Q := by
  cases Q with
  | zero => exact ⟨0,zero_add _⟩
  | @some x y hp =>
    let xx := 4*x
    let yy := 8*y+4
    have hY : yy^2=xx^3-16*xx+16 := by dsimp [xx,yy]; linear_combination 64 * curve_eq hp
    obtain ⟨s,t,hs,ht⟩ := halving_parameters xx yy hY h
    apply double_of_tangent (h:=hp) (U:=xx+t) (V:= -yy-s*t) (m:= -s)
    · linear_combination hY + t*ht + t^2*hs
    · linear_combination ht + 2*t*hs
    · dsimp [xx] at *; linarith only [hs]
    · dsimp [xx,yy]; ring


theorem image_of_xCoord {Q : E.Point} {x : ℚ} (h : xCoord Q=some x) :
    image Q=4*(x:L)-2*θ := by
  cases Q with
  | zero => cases h
  | @some x' y hp =>
    obtain rfl := Option.some.inj h
    simp [image,triple]; ring

theorem image_ne_zero (Q : E.Point) : image Q ≠ 0 := by
  cases Q with
  | zero => exact one_ne_zero
  | @some x y hp =>
    intro hz
    have he : triple (4*x) (-2) 0=triple 0 0 0 := by simpa only [image,triple,Rat.cast_zero,zero_mul,add_zero] using hz
    have hc := (triple_inj he).2.1
    norm_num at hc

/-- The Kummer representative of a double is a square. The explicit square
root has denominator 2y+1, which never vanishes at a rational point. -/
theorem square_of_double (Q : E.Point) : IsSquare (image (Q+Q)) := by
  cases Q with
  | zero => change IsSquare (image ((0:E.Point)+0)); rw [add_zero]; exact ⟨1, (one_mul _).symm⟩
  | @some x y hp =>
    have hy : (2*y+1)^2=4*x^3-4*x+1 := by linear_combination 4 * curve_eq hp
    have hG : 4*(x:L)^3-4*(x:L)+1≠0 := by exact_mod_cast cubic_ne_zero x
    have hD : (2*(y:L)+1)^2=4*(x:L)^3-4*(x:L)+1 := by exact_mod_cast hy
    have hn : 2*(y:L)+1≠0 := by intro h; apply hG; rw [←hD,h]; norm_num
    rw [image_of_xCoord (double_x hp)]
    refine ⟨(2*(x:L)^2-2*θ*(x:L)-θ^2+2)/(2*(y:L)+1),?_⟩
    rw [←sq,div_pow,hD]
    push_cast
    rw [←mul_div_assoc,eq_div_iff hG,sub_mul,div_mul_cancel₀ _ hG]
    linear_combination -(θ+4*(x:L))*theta_cube

theorem square_iff_double (Q : E.Point) :
    IsSquare (image Q) ↔ ∃ R : E.Point, R+R=Q :=
  ⟨double_of_square Q,fun ⟨R,h⟩ => h ▸ square_of_double R⟩

private theorem generated_at_zero_x (y : ℚ) (h : E.Nonsingular 0 y) :
    ∃ j : ℤ, j • P=Affine.Point.some h := by
  apply generated_of_height_le_sixteen
  norm_num [height,xCoord]

/-- The chord through the generator supplies a square in the cubic field.
All three representatives have nonzero norm. -/
theorem chord_with_generator {x y : ℚ} (hp : E.Nonsingular x y) (hx : x≠0) :
    IsSquare (image (Affine.Point.some hp) * image P * image (Affine.Point.some hp+P)) := by
  have ha : xCoord (Affine.Point.some hp+P)=some ((y/x)^2-x) := by
    unfold P
    rw [Affine.Point.add_of_X_ne hx]
    change some (E.addX x 0 (E.slope x 0 y 0)) = _
    simp [Affine.slope,hx,E]
  rw [image_of_xCoord ha,image_of_xCoord (Q:=Affine.Point.some hp) rfl,image_of_xCoord (Q:=P) rfl]
  have he : (y:L)^2+(y:L)=(x:L)^3-(x:L) := by exact_mod_cast curve_eq hp
  have hx' : (x:L)≠0 := by exact_mod_cast hx
  refine ⟨4+4*(y:L)*θ/(x:L),?_⟩
  push_cast
  field_simp [hx']
  linear_combination -8*(x:L)^2*theta_cube - 32*θ*(x:L)*he

/-- Restricting the cubic square classes of rational points to these two
explicit classes proves that P generates all rational points. -/
theorem cyclic_of_image_classes
    (hc : ∀ Q : E.Point, IsSquare (image Q) ∨ IsSquare (image Q * image P)) :
    PowerTests.Cyclic := by
  apply cyclic_of_mod_two
  intro Q
  rcases hc Q with h|⟨w,hw⟩
  · obtain ⟨R,hR⟩ := double_of_square Q h
    exact ⟨R,Or.inl hR.symm⟩
  cases Q with
  | zero => exact ⟨0,Or.inl (zero_add _).symm⟩
  | @some x y hp =>
    by_cases hx : x=0
    · subst x
      obtain ⟨j,hj⟩ := generated_at_zero_x y hp
      refine ⟨(j/2+j%2) • P,?_⟩
      rcases Int.emod_two_eq_zero_or_one j with h|h
      · left
        rw [←hj,←add_zsmul]
        congr 1
        omega
      · right
        calc _ = (j+1) • P := by rw [←hj,add_zsmul,one_zsmul]
             _ = _ := by rw [←add_zsmul]; congr 1; omega
    obtain ⟨v,hv⟩ := chord_with_generator hp hx
    have hw₀ : w≠0 := by
      rintro rfl
      apply mul_ne_zero (image_ne_zero _) (image_ne_zero P)
      simpa using hw
    have hs : IsSquare (image (Affine.Point.some hp + P)) := by
      refine ⟨v/w,?_⟩
      rw [div_mul_div_comm,eq_div_iff (mul_ne_zero hw₀ hw₀),←hw,mul_comm]
      exact hv
    obtain ⟨R,hR⟩ := double_of_square _ hs
    exact ⟨R,Or.inr hR.symm⟩

end
end DiophantineNP.Curve37.Kummer
