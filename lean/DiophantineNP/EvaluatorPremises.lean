import DiophantineNP.EvaluatorPacked

/-! # The remaining external hypotheses -/

namespace DiophantineNP

/-- The external inputs of the development. Each field is an explicit interface to an external result. -/
structure Premises where
  /-- `E(ℚ)` is generated by `P = (0,0)` on `y² + y = x³ - x`
  (Cremona's tables, LMFDB curve 37.a1). -/
  cyclic : PowerTests.Cyclic
  /-- The canonical height is quadratic on the multiples of `P`
  (Silverman, *The Arithmetic of Elliptic Curves*, Theorem VIII.9.3). -/
  quadratic : PowerTests.Quadratic
  /-- BIT, iterated product and iterated sum in the counting logic
  (Hesse, Allender and Barrington 2002, §2.3 and Corollary 6.3). -/
  templates : WidthFormula.LiteratureFormulas
  /-- The direction of the Jones–Matiyasevich criterion that the corollary uses. -/
  jm : Classes.JonesMatiyasevichDirection
  /-- A fixed integer polynomial can be evaluated in polynomial time on
  mathlib's `TM2` machines with the tape encoding of `Classes.lean`. -/
  machine : Classes.PolynomialEvaluationInP

/-- The evaluator specification of §3.5, proved by `Blueprint.packedScalarPrograms`. -/
def EvaluatorObligation : Prop :=
  PowerTests.Cyclic → PowerTests.Quadratic → PackedScalarPrograms

/-- The corollary from fixed integer programs instead of fixed systems. -/
theorem classEquality_of_packedScalarPrograms (programs : PackedScalarPrograms)
    (templates : WidthFormula.LiteratureFormulas) (jm : Classes.JonesMatiyasevichDirection)
    (machine : Classes.PolynomialEvaluationInP) : Classes.D = Classes.NP :=
  classEquality_of_packedScalarSystems (packedScalarSystems_of_programs programs)
    templates jm machine

/-- The class equality for a supplied evaluator and the external inputs. -/
theorem classEquality_of_evaluator (evaluator : EvaluatorObligation) (h : Premises) :
    Classes.D = Classes.NP :=
  classEquality_of_packedScalarPrograms (evaluator h.cyclic h.quadratic)
    h.templates h.jm h.machine

/-- Theorem 1.1 of the manuscript under the same inputs it needs. -/
theorem nativeVerifier_of_evaluator (evaluator : EvaluatorObligation)
    (cyclic : PowerTests.Cyclic) (quadratic : PowerTests.Quadratic)
    (templates : WidthFormula.LiteratureFormulas) : NativeVerifier :=
  nativeVerifier_of_packedScalarSystems
    (packedScalarSystems_of_programs (evaluator cyclic quadratic)) templates

/-- Equality of the two numerical language classes under the external inputs. -/
theorem classEquality_of_external (h : Premises) : Classes.D = Classes.NP :=
  classEquality_of_evaluator Blueprint.packedScalarPrograms h

/-- The fixed polynomial for native bitwise inclusion uses the two curve facts
and the three finite-arithmetic formulas. -/
theorem nativeVerifier_of_external (cyclic : PowerTests.Cyclic) (quadratic : PowerTests.Quadratic)
    (templates : WidthFormula.LiteratureFormulas) : NativeVerifier :=
  nativeVerifier_of_evaluator Blueprint.packedScalarPrograms cyclic quadratic templates

end DiophantineNP

