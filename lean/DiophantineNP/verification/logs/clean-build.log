          ∀ (U : ℕ),
            0 < U →
              ∀ (t : Fin k → Fin U),
                max (DiophantineNP.ScalarProgram.Term.peak (DiophantineNP.Packing.termInputs t) num)
                    (DiophantineNP.ScalarProgram.Term.peak (DiophantineNP.Packing.termInputs t) den) ≤
                  (1 + U) ^ c) ∧
        ∀ (U : ℕ),
          0 < U →
            ∀ (t : Fin k → Fin U),
              DiophantineNP.Packing.termRatio num den U t = DiophantineNP.FormulaLaurent.packedScalar φ t
